{
  "ConnectionStrings": {
    "Default": "Server=YOUR_SERVER;Database=YOUR_DATABASE;User ID=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Key": "replace-with-a-strong-jwt-key"
  },
  "MicrosoftExternalLogin": {
    "ClientId": "your-microsoft-client-id",
    "TenantId": "your-microsoft-tenant-id",
    "ObjectId": "your-microsoft-object-id"
  },
  "GoogleExternalLogin": {
    "ClientId": "your-google-client-id"
  },
  "GoogleDriveSettings": {
    "FolderId": "your-google-drive-folder-id",
    "ApplicationName": "your-google-application-name"
  },
  "TelegramStorageSettings": {
    "BotToken": "your-telegram-bot-token",
    "ChatId": "your-telegram-chat-id"
  },
  "Salesforce": {
    "AuthUrl": "https://your-domain.my.salesforce.com",
    "ClientId": "your-salesforce-client-id",
    "ClientSecret": "your-salesforce-client-secret",
    "CallbackUrl": "https://localhost:5001/auth/salesforce/callback"
  }
}
